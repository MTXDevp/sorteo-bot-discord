# Copia a `.env` y rellena tu token (nunca subas `.env` a git).
# Portal: https://discord.com/developers/applications
DISCORD_TOKEN=pon-tu-token-aqui

# Prefijo legacy (los slash-commands `/...` funcionan siempre).
COMMAND_PREFIX=!
LOG_LEVEL=INFO

# Canales de voz (insensible a mayúsculas/minúsculas).
VOICE_CHANNEL_SORTEO=Sorteo
VOICE_CHANNEL_EVENTO=Evento

# Persistencia.
SQLITE_PATH=data/sorteo.db
LEGACY_JSON_PATH=participaciones.json

# Resolución difusa de nombres 0-100 (RapidFuzz).
FUZZY_THRESHOLD=70
DRAW_REVEAL_DELAY_SECONDS=1.5
